import seq

const RADIUS_X : Int = 33
const RADIUS_Y : Int = 15

fn sieve(xs: Seq[Int]) : Seq[Int] = match xs {
  []           -> lazy []
  [p, ...rest] -> lazy [p, ...sieve(rest |? (x) => x % p != 0)]
}

fn ring_number(x: Int, y: Int) : Int = {
  let k = if abs(x) > abs(y) { abs(x) } else { abs(y) }
  let m = (2 * k + 1) * (2 * k + 1)
  if y == 0 - k { m - (k - x) }
  else if x == 0 - k { m - 2 * k - (y + k) }
  else if y == k { m - 4 * k - (x + k) }
  else { m - 6 * k - (k - y) }
}

fn prime_table(primes: [Int], size: Int) : Vec[Bool] = {
  let blank: Vec[Bool] = [0..size] | ((i) => false)
  primes |> list.foldl(blank, (t, p) => vec_set(t, p, true))
}

fn cell(table: Vec[Bool], x: Int, y: Int) : String =
  if x == 0 and y == 0 { "o" }
  else if table[ring_number(x, y)] { "#" }
  else { " " }

fn columns(row: [Int]) : String = row | "#{.:5}" |> string.join("")

fn spiral_row(table: Vec[Bool], y: Int) : String =
  [0 - RADIUS_X..RADIUS_X] | cell(table, ., y) |> string.join("")

fn main() : Unit / Stdout = {
  let primes = sieve(lazy [2..])
  println("The first 60 primes, from a lazy sieve of Eratosthenes:")
  println("")
  primes |> take(60) |> to_list() |> list.chunk(12)
    |! println(columns(.))
  println("")
  println("The 500th prime is #{primes |> nth(499)}")
  let small = primes |> take_while((p) => p < 200) |> to_list()
  let twins = list.zip(small, list.drop(small, 1))
    |? (.snd - .fst == 2) | "(#{.fst}, #{.snd})"
  println("Twin primes below 200: #{twins |> string.join(" ")}")
  println("")
  let side = 2 * RADIUS_X + 1
  let limit = side * side
  println("Ulam spiral: 1 at 'o', counting outwards; '#' marks a prime")
  println("")
  let table = prime_table(primes |> take_while((p) => p <= limit) |> to_list(), limit)
  [RADIUS_Y, RADIUS_Y - 1..0 - RADIUS_Y] |! println(spiral_row(table, .))
}
