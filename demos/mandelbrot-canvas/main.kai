import math.real
import time

const W : Int = 600

const H : Int = 400

const MAX_ITER : Int = 500

extern "js" opaque Node

extern "js" opaque Ctx

extern "js" opaque Image

extern "js"("document.getElementById") fn element(id: String) : Node / Js

extern "js"(".getContext") fn context(canvas: Node, kind: String) : Ctx / Js

extern "js"("pixels.image") fn image(w: I32, h: I32) : Image / Js

extern "js"("pixels.set") fn set_pixel(img: Image, i: I32, rgb: I32) : Unit / Js

extern "js"(".putImageData") fn put_rows(
  ctx: Ctx,
  img: Image,
  x: I32,
  y: I32,
  dx: I32,
  dy: I32,
  dw: I32,
  dh: I32
) : Unit / Js

type Stop = { at: Real, r: Real, g: Real, b: Real }

# The classic Ultra Fractal gradient: deep blue, white, gold, black.
const STOPS : [Stop] = [
  Stop { at: 0.0, r: 0.0, g: 7.0, b: 100.0 },
  Stop { at: 0.16, r: 32.0, g: 107.0, b: 203.0 },
  Stop { at: 0.42, r: 237.0, g: 255.0, b: 255.0 },
  Stop { at: 0.6425, r: 255.0, g: 170.0, b: 0.0 },
  Stop { at: 0.8575, r: 0.0, g: 2.0, b: 0.0 },
  Stop { at: 1.0, r: 0.0, g: 7.0, b: 100.0 }
]

# Escape time with the fractional part that hides the colour bands; -1 inside the set.
fn escape(cr: Real, ci: Real, zr: Real, zi: Real, n: Int) : Real {
  let m = zr * zr + zi * zi
  if n >= MAX_ITER {
    -1.0
  } else if m > 256.0 {
    int_to_real(n) + 1.0 - real_log2(real_log2(m) / 2.0)
  } else {
    escape(cr, ci, zr * zr - zi * zi + cr, 2.0 * zr * zi + ci, n + 1)
  }
}

fn mix(a: Real, b: Real, t: Real) : Int = real_to_int(a + (b - a) * t)

fn blend(stops: [Stop], t: Real) : Int = match stops {
  [a, b, ...rest] ->
    if t <= b.at {
      let k = (t - a.at) / (b.at - a.at)
      mix(a.r, b.r, k) * 65536 + mix(a.g, b.g, k) * 256 + mix(a.b, b.b, k)
    } else {
      blend([b, ...rest], t)
    }
  _ -> 0
}

fn colour(mu: Real) : Int =
  if mu < 0.0 {
    0
  } else {
    let s = real_sqrt(mu) * 0.25
    blend(STOPS, s - real.floor(s))
  }

fn pixel(x: Int, y: Int) : Int {
  let cr = (-2.3) + 3.45 * int_to_real(x) / int_to_real(W)
  let ci = (-1.15) + 2.3 * int_to_real(y) / int_to_real(H)
  colour(escape(cr, ci, 0.0, 0.0, 0))
}

fn row(img: Image, y: Int) : Unit / Js =
  [0..(W - 1)] |! set_pixel(img, y * W + ., pixel(., y))

# A sleep of zero returns at once; one millisecond waits for the next animation
# frame, which shows the new row.
fn draw(ctx: Ctx, img: Image, y: Int) : Unit / Js + Clock =
  if y < H {
    row(img, y)
    put_rows(ctx, img, 0, 0, 0, y, W, 1)
    sleep(millis(1))
    draw(ctx, img, y + 1)
  }

fn main() : Unit / Js + Clock = draw(context(element("canvas"), "2d"), image(W, H), 0)
