import bin
import math.real as real
import web.dom
import web.run
import web.timer

const W : Int = 600

const H : Int = 400

const MAX_ITER : Int = 500

const BUDGET_MS : Int = 12

type Stop = { at: Real, r: Real, g: Real, b: Real }

# The classic Ultra Fractal gradient: deep blue, white, gold, black.
const STOPS : [Stop] = [
  Stop { at: 0.0, r: 0.0, g: 7.0, b: 100.0 },
  Stop { at: 0.16, r: 32.0, g: 107.0, b: 203.0 },
  Stop { at: 0.42, r: 237.0, g: 255.0, b: 255.0 },
  Stop { at: 0.6425, r: 255.0, g: 170.0, b: 0.0 },
  Stop { at: 0.8575, r: 0.0, g: 2.0, b: 0.0 },
  Stop { at: 1.0, r: 0.0, g: 7.0, b: 100.0 }
]

# Escape time with the fractional part that hides the colour bands; -1 inside the set.
fn escape(cr: Real, ci: Real, zr: Real, zi: Real, n: Int) : Real {
  let m = zr * zr + zi * zi
  if n >= MAX_ITER {
    -1.0
  } else if m > 256.0 {
    int_to_real(n) + 1.0 - real_log2(real_log2(m) / 2.0)
  } else {
    escape(cr, ci, zr * zr - zi * zi + cr, 2.0 * zr * zi + ci, n + 1)
  }
}

fn mix(a: Real, b: Real, t: Real) : Int = real_to_int(a + (b - a) * t)

fn blend(stops: [Stop], t: Real) : Int = match stops {
  [a, b, ...rest] ->
    if t <= b.at {
      let k = (t - a.at) / (b.at - a.at)
      mix(a.r, b.r, k) * 65536 + mix(a.g, b.g, k) * 256 + mix(a.b, b.b, k)
    } else {
      blend([b, ...rest], t)
    }
  _ -> 0
}

fn colour(mu: Real) : Int =
  if mu < 0.0 {
    0
  } else {
    let s = real_sqrt(mu) * 0.25
    blend(STOPS, s - real.floor(s))
  }

fn colour_at(x: Int, y: Int) : Int {
  let cr = (-2.3) + 3.45 * int_to_real(x) / int_to_real(W)
  let ci = (-1.15) + 2.3 * int_to_real(y) / int_to_real(H)
  colour(escape(cr, ci, 0.0, 0.0, 0))
}

fn put(px: Array[Byte], i: Int, rgb: Int) : Unit / Mutable {
  px[i * 4] := bin.byte(rgb / 65536)
  px[i * 4 + 1] := bin.byte(rgb / 256 % 256)
  px[i * 4 + 2] := bin.byte(rgb % 256)
  px[i * 4 + 3] := 255u8
}

fn row(px: Array[Byte], y: Int, x: Int) : Unit / Mutable =
  if x < W {
    put(px, y * W + x, colour_at(x, y))
    row(px, y, x + 1)
  }

fn rows(px: Array[Byte], y: Int, deadline: Int) : Int / Timer + Mutable =
  if y < H and Timer.now_ms() < deadline {
    row(px, y, 0)
    rows(px, y + 1, deadline)
  } else {
    y
  }

# Each animation frame computes rows for BUDGET_MS and shows them with one put_pixels.
fn draw(ctx: Ctx2d, px: Array[Byte], y: Int) : Unit / Dom + Timer + Mutable =
  if y < H {
    let next = rows(px, y, Timer.now_ms() + BUDGET_MS)
    Dom.put_pixels(ctx, px, W, H, 0, 0)
    Timer.animation_frame() |> ignore
    draw(ctx, px, next)
  }

fn main() : Unit / Js + Ffi + Clock + Mutable =
  run.run(() => {
    let canvas = Dom.query("#canvas") ?? Dom.create("canvas")
    draw(Dom.context_2d(canvas), array_make(W * H * 4, 0u8), 0)
  })
