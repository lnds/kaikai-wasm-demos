import bin
import web.dom
import web.run
import web.timer

const W : Int = 200

const H : Int = 125

const TAU : Real = 6.283185307179586

fn channel(t: Real, freq: Real, phase: Real) : Int =
  real_to_int(127.5 + 127.5 * real_cos(TAU * (freq * t + phase)))

fn tint(pal: Array[Byte], i: Int) : Unit / Mutable {
  let t = int_to_real(i) / 256.0
  pal[i * 4] := bin.byte(channel(t, 1.0, 0.5))
  pal[i * 4 + 1] := bin.byte(channel(t, 2.0, 0.2))
  pal[i * 4 + 2] := bin.byte(channel(t, 1.0, 0.25))
}

# 256 RGBA colours from a cosine gradient that wraps around; the frame number rotates the lookup.
fn palette() : Array[Byte] / Mutable {
  let pal = array_make(256 * 4, 255u8)
  [0..255] |! tint(pal, .)
  pal
}

fn plasma(x: Real, y: Real, t: Real) : Real {
  let cx = x + 0.5 * real_sin(t / 5.0)
  let cy = y + 0.5 * real_cos(t / 3.0)
  real_sin(x * 10.0 + t)
    + real_sin(10.0 * (x * real_sin(t / 2.0) + y * real_cos(t / 3.0)) + t)
    + real_sin(real_sqrt(100.0 * (cx * cx + cy * cy) + 1.0) + t)
}

fn shade(i: Int, frame: Int) : Int {
  let x = int_to_real(i % W) / int_to_real(H) - 0.8
  let y = int_to_real(i / W) / int_to_real(H) - 0.5
  (real_to_int((plasma(x, y, int_to_real(frame) * 0.04) + 3.0) * 42.5) + frame) % 256
}

fn render(px: Array[Byte], pal: Array[Byte], frame: Int, i: Int) : Unit / Mutable =
  if i < W * H {
    let from = shade(i, frame) * 4
    px[i * 4] := pal[from]
    px[i * 4 + 1] := pal[from + 1]
    px[i * 4 + 2] := pal[from + 2]
    px[i * 4 + 3] := 255u8
    render(px, pal, frame, i + 1)
  }

type Screen = { ctx: Ctx2d, status: Node, pixels: Array[Byte], pal: Array[Byte] }

# Every 30 rendered frames the status line reports the rate measured since `mark`.
fn report(s: Screen, n: Int, mark: Real, now: Real) : Real / Dom =
  if n % 30 != 0 {
    mark
  } else {
    if n > 0 {
      Dom.set_text(s.status, "frame #{n} · #{real_to_int(30000.0 / max(now - mark, 1.0))} fps")
    }
    now
  }

# The plasma moves at 30 steps a second of page time, whatever the display's rate.
fn animate(s: Screen, t0: Real, n: Int, mark: Real) : Unit / Dom + Timer + Mutable {
  let now = Timer.animation_frame()
  render(s.pixels, s.pal, real_to_int((now - t0) * 0.03), 0)
  Dom.put_pixels(s.ctx, s.pixels, W, H, 0, 0)
  animate(s, t0, n + 1, report(s, n, mark, now))
}

fn main() : Unit / Js + Ffi + Clock + Mutable =
  run.run(() => {
    let canvas = Dom.query("#canvas") ?? Dom.create("canvas")
    let screen = Screen {
      ctx: Dom.context_2d(canvas),
      status: Dom.query("#status") ?? canvas,
      pixels: array_make(W * H * 4, 255u8),
      pal: palette()
    }
    let t0 = Timer.animation_frame()
    animate(screen, t0, 0, t0)
  })
