import time

const W : Int = 200

const H : Int = 125

const FRAME_NS : Int = 33_000_000

extern "js" opaque Node

extern "js" opaque Ctx

extern "js" opaque Image

extern "js"("document.getElementById") fn element(id: String) : Node / Js

extern "js"(".textContent=") fn set_text(n: Node, s: String) : Unit / Js

extern "js"(".getContext") fn context(canvas: Node, kind: String) : Ctx / Js

extern "js"("pixels.image") fn image(w: I32, h: I32) : Image / Js

extern "js"("pixels.set") fn set_pixel(img: Image, i: I32, rgb: I32) : Unit / Js

extern "js"("pixels.show") fn show(ctx: Ctx, img: Image, smooth: Bool) : Unit / Js

const TAU : Real = 6.283185307179586

fn channel(t: Real, freq: Real, phase: Real) : Int =
  real_to_int(127.5 + 127.5 * real_cos(TAU * (freq * t + phase)))

# 256 colours from a cosine gradient that wraps around; the frame number rotates the lookup.
fn palette() : Vec[Int] {
  let v: Vec[Int] = [0..255]
    | (i => {
      let t = int_to_real(i) / 256.0
      channel(t, 1.0, 0.5) * 65536 + channel(t, 2.0, 0.2) * 256 + channel(t, 1.0, 0.25)
    })
  v
}

fn plasma(x: Real, y: Real, t: Real) : Real {
  let cx = x + 0.5 * real_sin(t / 5.0)
  let cy = y + 0.5 * real_cos(t / 3.0)
  real_sin(x * 10.0 + t)
    + real_sin(10.0 * (x * real_sin(t / 2.0) + y * real_cos(t / 3.0)) + t)
    + real_sin(real_sqrt(100.0 * (cx * cx + cy * cy) + 1.0) + t)
}

fn shade(pal: Vec[Int], v: Real, frame: Int) : Int =
  pal[(real_to_int((v + 3.0) * 42.5) + frame) % 256]

fn colour(pal: Vec[Int], i: Int, frame: Int) : Int {
  let x = int_to_real(i % W) / int_to_real(H) - 0.8
  let y = int_to_real(i / W) / int_to_real(H) - 0.5
  shade(pal, plasma(x, y, int_to_real(frame) * 0.04), frame)
}

fn render(img: Image, pal: Vec[Int], frame: Int) : Unit / Js =
  [0..(W * H - 1)] |! set_pixel(img, ., colour(pal, ., frame))

# Sleeps until `due` (monotonic nanoseconds), or one animation frame when late,
# and returns the next deadline.
fn pace(due: Int) : Int / Clock {
  let now = instant_to_nanos(monotonic())
  if due > now { sleep(nanos_dur(due - now)) } else { sleep(millis(1)) }
  max(due, now) + FRAME_NS
}

type Screen = { ctx: Ctx, img: Image, status: Node, pal: Vec[Int] }

# Every 30 frames the status line reports the rate measured since `mark`.
fn report(s: Screen, frame: Int, mark: Int) : Int / Js + Clock =
  if frame % 30 != 0 {
    mark
  } else {
    let now = instant_to_nanos(monotonic())
    if frame > 0 {
      set_text(s.status, "frame #{frame} · #{30_000_000_000 / max(now - mark, 1)} fps")
    }
    now
  }

fn animate(s: Screen, frame: Int, due: Int, mark: Int) : Unit / Js + Clock {
  render(s.img, s.pal, frame)
  show(s.ctx, s.img, true)
  let mark2 = report(s, frame, mark)
  animate(s, frame + 1, pace(due), mark2)
}

fn main() : Unit / Js + Clock {
  let screen = Screen {
    ctx: context(element("canvas"), "2d"),
    img: image(W, H),
    status: element("status"),
    pal: palette()
  }
  let now = instant_to_nanos(monotonic())
  animate(screen, 0, now, now)
}
